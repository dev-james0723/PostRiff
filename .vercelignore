# Vercel uploads source before function-level excludeFiles runs.
# Keep only the two service source trees and their deployment configuration.
.env*
.gitignore
.vercelignore
.vercel/
.venv/
.phase3-build-venv/
.*-broker-*
.upgrade-*
broker.key
*.command
studio-install-manifest.json
/companion-ios/
/desktop/
/docs/
/migrations/
/scripts/
/templates/
/tests/
/vendor/
src/james_au_social/
src/postriff_alpha/__pycache__/
src/postriff_phase2/__pycache__/
studio/README.md
studio/Start Studio.command
studio/agent/
studio/bilibili/
studio/broker/
studio/requirements.lock.txt
studio/requirements.txt
studio/tiktok-runtime/
studio/web/
web/node_modules/
web/.next/
web/.env*.local

