# Vercel uploads source before function-level excludeFiles runs.
# Keep only the two service source trees and their deployment configuration.
.env*
.gitignore
.vercelignore
.vercel/
.venv/
.phase3-build-venv/
.*-broker-*
.upgrade-*
broker.key
*.command
studio-install-manifest.json
/companion-ios/
/desktop/
/docs/
/migrations/
/scripts/
/templates/
/tests/
/vendor/
src/james_au_social/
# Person-specific Studio skills (private in skills/rafii-registry.json) never ship with the hosted product.
skills/james-au-*/
src/postriff_alpha/__pycache__/
src/postriff_phase2/__pycache__/
studio/README.md
studio/Start Studio.command
studio/agent/
studio/bilibili/
studio/broker/
studio/requirements.lock.txt
studio/requirements.txt
studio/tiktok-runtime/
studio/web/
web/node_modules/
web/.next/
web/.env*.local

# Local task state, research archives and private tooling never enter a deployment.
/.codex/
/.claude/
/.agents/
/.token-pilot/
/.superpowers/
/.git
/.git/
/PostRiff_Research_2026-09-18/
/*.zip
/*.md
/.phase3-qualification/
/.pytest_cache/
/.trend-storage-test/
/.trend-operations-test/
/.github/
/integrations/
/motion/
.DS_Store
**/__pycache__/
**/*.pyc
web/.next*/
web/.env*
web/tests/
web/plans/
requirements-dev.txt

# Rafii Control v2 runtime (src/rafii_control/, with its catalog pack) ships embedded in the consumer API
# (RAFII_CONTROL_MOUNT=embedded). Its separate-project web app, entrypoint and deployment files never do.
/.control-venv
/.control-browsers/
/control-web/
/api/control.py
/requirements-control.txt
/vercel.control.json
