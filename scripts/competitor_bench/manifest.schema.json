{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen offline competitor benchmark manifest",
  "type": "object",
  "required": ["run_id", "hypothesis", "preregistered_at", "decision_cutoff", "preregistration_hash", "topics", "query_grid", "planned_observation_times", "actual_observation_times", "rights_refs", "cost_cap", "input_hashes", "candidate_versions", "metric_definitions", "exclusions", "counterexamples", "reviewer"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string"},
    "preregistered_at": {"type": "string", "format": "date-time"},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "preregistration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topics": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "required": ["topic_id", "cohort", "split"], "properties": {"topic_id": {"type": "string"}, "cohort": {"type": "string"}, "split": {"enum": ["development", "holdout"]}}}},
    "query_grid": {"type": "array", "maxItems": 5000, "items": {"type": "object", "required": ["query", "language", "window", "geography"]}},
    "planned_observation_times": {"type": "array", "items": {"type": "string", "format": "date-time"}},
    "actual_observation_times": {"type": "array", "items": {"type": "string", "format": "date-time"}},
    "rights_refs": {"type": "array", "items": {"type": "string"}},
    "cost_cap": {"type": "number", "minimum": 0},
    "input_hashes": {"type": "array", "items": {"type": "string"}},
    "candidate_versions": {"type": "object"},
    "metric_definitions": {"type": "object"},
    "exclusions": {"type": "array"},
    "counterexamples": {"type": "array"},
    "reviewer": {"type": "string"}
  }
}
