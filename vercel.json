{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "postriff_web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "postriff_api": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "excludeFiles": "{.venv/**,.phase3-build-venv/**,.vercel/**,.env*,broker.key,*.command,studio-install-manifest.json,tests/**,docs/**,studio/**,desktop/**,vendor/**,companion-ios/**,skills/**,templates/**,scripts/**,migrations/**,src/james_au_social/**,**/__pycache__/**,web/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "postriff_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "postriff_web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/worker",
      "schedule": "* * * * *"
    }
  ]
}
