{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postriff:candidate:metric-point:v1",
  "type": "object",
  "properties": {
    "metricKey": {
      "type": "string"
    },
    "definitionVersion": {
      "type": "integer",
      "minimum": 1
    },
    "accountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "objectKey": {
      "type": "string"
    },
    "value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "valueStatus": {
      "type": "string",
      "enum": [
        "measured",
        "not_connected",
        "scope_missing",
        "not_supported",
        "not_applicable",
        "pending_provider",
        "suppressed",
        "stale",
        "error",
        "deleted",
        "unavailable"
      ]
    },
    "unit": {
      "type": "string"
    },
    "sourceKind": {
      "type": "string",
      "enum": [
        "provider_api",
        "native_export",
        "manual_entry",
        "first_party"
      ]
    },
    "execution": {
      "type": "string",
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "period": {
      "type": "object",
      "properties": {
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "period",
            "lifetime",
            "snapshot"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "nativePeriodKey": {
          "type": "string"
        }
      },
      "required": [
        "grain",
        "start",
        "end",
        "timezone",
        "nativePeriodKey"
      ],
      "additionalProperties": false
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "availableThrough": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "definition": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "expected",
        "observed",
        "definition",
        "complete"
      ],
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string"
    },
    "derived": {
      "type": "boolean"
    },
    "lastKnownValue": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataDomain": {
      "type": "string",
      "enum": [
        "first_party",
        "social"
      ]
    },
    "workspaceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "metricKey",
    "definitionVersion",
    "accountId",
    "objectKey",
    "value",
    "valueStatus",
    "unit",
    "sourceKind",
    "execution",
    "freshness",
    "period",
    "observedAt",
    "availableThrough",
    "coverage",
    "evidenceRef",
    "policyVersion",
    "derived",
    "lastKnownValue",
    "dataDomain",
    "workspaceId",
    "currency"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "valueStatus": {
            "const": "measured"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataDomain": {
            "const": "social"
          }
        }
      },
      "then": {
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "provider_api",
              "native_export",
              "manual_entry"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "accountId": {
            "type": "null"
          },
          "sourceKind": {
            "const": "first_party"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit": {
            "const": "currency"
          }
        }
      },
      "then": {
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "else": {
        "properties": {
          "currency": {
            "type": "null"
          }
        }
      }
    }
  ]
}
