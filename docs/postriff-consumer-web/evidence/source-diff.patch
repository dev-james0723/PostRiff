+def resolve(tool_id, version=None):
+    if not isinstance(tool_id, str):
+        raise AlphaError("Unknown tool.", 404)
+    matches = [v for (tid, ver), v in REGISTRY.items() if tid == tool_id and (version is None or ver == version)]
