+.unknowns ul{margin:4px 0 0;padding-left:16px}
+.message.warning{background:var(--warn-soft);color:var(--warn);border-color:#e6c3b5}
+.previews{display:flex;flex-direction:column;gap:16px}
+.post-preview{background:#fffefa;border:1px solid var(--rule);border-radius:12px;padding:14px 16px;box-shadow:0 10px 30px #26302111}
+.post-preview header{display:flex;gap:10px;align-items:center;margin-bottom:8px}
+.post-preview header span:last-child{display:flex;flex-direction:column;font-size:12px}
