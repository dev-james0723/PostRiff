+/* Milestone E — cloud surfaces, shell refinements, mobile nav, PWA affordances.
+   Extends the founder design language: paper / moss / lime, serif display, editorial spacing. */
+:root{--moss-soft:#e4ead8;--paper-deep:#efeee6;--rule:#dedfd4;--warn:#a34325;--warn-soft:#f6e6df;--radius:8px}
+.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+
+/* ── Shell: collapsible sidebar (desktop) ───────────────────────────── */
+.sidebar{transition:width .18s ease}
+.collapse-toggle{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;margin:-6px -8px 10px auto;border-radius:6px;color:#5d655c;font-size:15px}
+.collapse-toggle:hover{background:#e3e3d8}
+.alpha-app.collapsed .sidebar{width:76px;padding-inline:14px}
+.alpha-app.collapsed .app-body{margin-left:76px;width:calc(100% - 76px)}
+.alpha-app.collapsed .wordmark{justify-content:center}
+.alpha-app.collapsed .wordmark > :not(.brand-mark),.alpha-app.collapsed .workspace-label > :not(.avatar),.alpha-app.collapsed .nav-label,.alpha-app.collapsed .nav-item > :not(.nav-symbol),.alpha-app.collapsed .local-card{display:none}
+.alpha-app.collapsed .nav-item{justify-content:center;padding-inline:0}
+.alpha-app.collapsed .nav-item .nav-symbol{font-size:18px}
+.alpha-app.collapsed .collapse-toggle{margin-inline:auto}
+
+/* ── Topbar: Create + account menu ─────────────────────────────────── */
+.create-button{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border-radius:999px;background:var(--green);color:#fffefa;font-size:12px;font-weight:600;letter-spacing:.2px}
+.create-button:hover{background:#1f3d2d}
+.account-button{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border-radius:999px}
+.account-button[aria-expanded="true"] .avatar{outline:2px solid var(--green);outline-offset:2px}
+.account-anchor{position:relative}
+.account-menu{position:absolute;right:0;top:calc(100% + 8px);min-width:250px;background:#fffefa;border:1px solid var(--rule);border-radius:10px;box-shadow:0 18px 50px #26302122;padding:6px;z-index:40;display:flex;flex-direction:column}
+.account-menu button{display:flex;flex-direction:column;align-items:flex-start;gap:2px;width:100%;text-align:left;padding:10px 12px;min-height:44px;border-radius:6px;font-size:13px;color:var(--ink)}
+.account-menu button small{color:var(--muted);font-size:11px}
+.account-menu button:hover,.account-menu button:focus-visible{background:var(--paper-deep)}
+.account-menu button.danger{color:var(--warn)}
+.dev-banner{background:#2f2a20;color:#f2e9c9;font-size:10px;letter-spacing:1.2px;text-transform:uppercase;padding:7px 42px;display:flex;gap:14px;align-items:center}
+.dev-banner .banner-dot{background:#e8c86a}
+
+/* ── Mobile bottom nav (4 + More) ──────────────────────────────────── */
+.bottom-nav{display:none}
+.more-sheet{display:none}
+@media(max-width:700px){
+ .menu-toggle,.collapse-toggle{display:none!important}
+ .sidebar,.sidebar.is-open{display:none!important}
+ .app-body{padding-bottom:calc(74px + env(safe-area-inset-bottom))}
+ .bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:30;display:grid;grid-template-columns:repeat(5,1fr);background:#fffefa;border-top:1px solid var(--rule);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
+ .bottom-nav button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:54px;min-width:44px;border-radius:8px;font-size:10px;letter-spacing:.3px;color:#5d655c}
+ .bottom-nav button .nav-symbol{font-size:18px;line-height:1}
+ .bottom-nav button[aria-current="page"]{color:var(--green);background:var(--moss-soft)}
+ .more-sheet{display:block;position:fixed;inset:0;z-index:35;background:#26302199}
+ .more-sheet .sheet-body{position:absolute;left:0;right:0;bottom:0;background:#fffefa;border-radius:18px 18px 0 0;padding:18px 18px calc(18px + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:4px}
+ .more-sheet .sheet-body h2{font-family:var(--serif);font-weight:400;font-size:22px;margin:0 0 8px}
+ .more-sheet button.row{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:48px;padding:0 10px;border-radius:8px;font-size:15px;text-align:left}
+ .more-sheet button.row:hover{background:var(--paper-deep)}
+ .create-button span.label{display:none}
+ .dev-banner{padding-inline:15px;font-size:9px}
+ .topbar-right{gap:6px}
+}
+
+/* ── Ideas: three panes, segmented on mobile ───────────────────────── */
+.ideas-cloud{display:grid;grid-template-columns:200px minmax(0,1fr);gap:28px;align-items:start}
