+            cur.execute("SELECT id::text,connection_id,provider,provider_post_id,provider_comment_id,author_handle,text,extract(epoch from ingested_at),tombstoned_at IS NOT NULL FROM public.pr_audience_threads WHERE workspace_id=%s ORDER BY ingested_at DESC LIMIT 200", (workspace_id,))
