+@media(max-width:1180px){.panes{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.pane-preview{grid-column:1/-1}}
+@media(max-width:980px){.ideas-cloud{grid-template-columns:1fr}.conv-list{border-right:0;padding-right:0;min-height:0;border-bottom:1px solid var(--rule);padding-bottom:12px}.conv-list ul{flex-direction:row;overflow:auto}.conv{white-space:nowrap}}
+@media(max-width:700px){
