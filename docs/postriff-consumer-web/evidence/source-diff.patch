+"""Milestone C unit tests: credential vault, PKCE, capability taxonomy, tz-db, OAuth routes."""
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
