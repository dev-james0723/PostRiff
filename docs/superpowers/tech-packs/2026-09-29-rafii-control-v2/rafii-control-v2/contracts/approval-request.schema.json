{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rafii-control:v2:approval-request",
  "title": "approval-request",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid"
    },
    "proposalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stepUpProofId": {
      "type": "string",
      "format": "uuid"
    },
    "confirmation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "proposalId",
    "proposalVersion",
    "actionDigest",
    "stepUpProofId",
    "confirmation"
  ],
  "additionalProperties": false
}
