+class ZhihuUI:
+    def __init__(self, ctx):
+        self.ctx=ctx; self.page=ctx.new_page(); self.page.set_default_timeout(10000)
+    def one(self, locator):
+        if locator.count()!=1 or not locator.is_visible(): raise Stop('ui_changed')
