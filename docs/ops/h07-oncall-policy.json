  "escalation": {
    "_note": "after = seconds since the chain started (the incident opened, was raised, or its suppression ended). A duty step counts only seconds inside duty hours and fires only inside them; outsideHours lists the channels that still go at once outside them. Steps resolve the person on call when they fire.",
    "P0": [
      {"after": 0, "to": "primary", "channels": ["push", "email"]},
      {"after": 300, "to": "primary", "channels": ["phone"]},
      {"after": 600, "to": "backup", "channels": ["push", "email", "phone"]}
    ],
    "P1": [
      {"after": 0, "to": "primary", "channels": ["push", "email"], "hours": "duty", "outsideHours": ["email"]},
      {"after": 900, "to": "backup", "channels": ["push", "email"], "hours": "duty"}
    ],
    "P2": [
      {"after": 0, "to": "primary", "channels": ["email"], "hours": "duty"}
    ]
  },
  "repeat": {
    "_note": "An unacknowledged P0 runs its chain again every 15 minutes, three rounds in all [proposal: the policy does not say what happens after the Backup].",
    "P0": {"periodSeconds": 900, "rounds": 3}
  },
  "records": {
    "_note": "E-mails that record the incident's status and outcome to everyone paged for it.",
    "P0": ["acknowledged", "resolved"],
    "P1": ["acknowledged", "resolved"],
    "P2": []
  },
  "suppression": {
    "neverSuppress": ["CROSS_TENANT_PROBE_FAILED", "CROSS_TENANT_PROBING", "DELIVERY_UNAUTHORIZED", "DELIVERY_UNCERTAIN",
                      "ONCALL_ROSTER_INVALID", "ONCALL_DELIVERY_FAILED", "ONCALL_AUTO_HOLD_ENGAGED", "ONCALL_AUTO_HOLD_FAILED",
                      "ONCALL_HEARTBEAT_STALE"],
    "inhibit": [
      {"when": "SILENT_HALT_DATABASE", "suppress": ["SILENT_HALT_PROJECTION", "SILENT_HALT_NO_PROGRESS", "SILENT_HALT_LANE_NOT_READY", "SILENT_HALT_NO_SHARDS", "BACKLOG_LAG"]},
      {"when": "SILENT_HALT_OPERATOR_HOLD", "suppress": ["SILENT_HALT_NO_PROGRESS", "BACKLOG_LAG"]},
      {"when": "RATE_CREDENTIAL_HOLD", "suppress": ["SILENT_HALT_NO_PROGRESS", "BACKLOG_LAG"]},
      {"when": "CONFIG_FLAGS", "suppress": ["SILENT_HALT_NO_PROGRESS", "SILENT_HALT_LANE_NOT_READY", "BACKLOG_LAG"]},
      {"when": "CONFIG_KILL_SWITCH", "suppress": ["SILENT_HALT_NO_PROGRESS", "BACKLOG_LAG"]}
    ],
    "maintenance": [],
    "reopenWithinSeconds": 600,
    "resolveAfterClearEvaluations": 2,
    "noDataRules": ["SILENT_HALT_HEALTH_UNANSWERED", "SILENT_HALT_DATABASE", "SILENT_HALT_SECTION"],
    "storm": {"windowSeconds": 600, "limits": {"push": 6, "email": 10, "phone": 2}}
  },
  "fallback": {
    "_note": "When the first channel of a step fails for its person (no destination, provider failure or refusal), the next step of the same round fires at once instead of waiting.",
    "escalateNowWhenFirstChannelFails": true
  },
  "autoHold": {
    "_note": "Option D, an owner decision, off by default: only with RAFII_ONCALL_AUTO_HOLD_ENABLED exactly 'true' and an injected executor. The review of 8e76afdd and the Release Captain advise against automating the hold, because the hold itself strands posts (read-backs parked 24 h when the lane does not own Discord, approvals lapsing from about 55 minutes after each post's scheduled time). If the owner enables it anyway, it engages the PHONE-RUNBOOK HOLD_ON statement only on a failing isolation probe (a confirmed exposure); never on probing, which is the gate working; never lifts it.",
    "rules": ["CROSS_TENANT_PROBE_FAILED"],
    "severity": "page"
  },
  "heartbeat": {"maxAgeSeconds": 180},
  "roster": {
    "_note": "PLACEHOLDER. The owner names a real Primary and Backup; destinations are opaque references resolved by the delivery adapters (for example a founder operator id), never an address or number in this file.",
    "shifts": [
      {"days": "daily", "start": "00:00", "end": "24:00", "primary": "PRIMARY", "backup": "BACKUP"}
    ],
    "people": {
      "PRIMARY": {"push": null, "email": null, "phone": null},
      "BACKUP": {"push": null, "email": null, "phone": null}
    }
