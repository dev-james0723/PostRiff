{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "public":false,
  "services":{
    "control_web":{"root":"control-web/","framework":"nextjs"},
    "control_api":{"root":".","runtime":"python","entrypoint":"api.control:app","functions":{"api/control.py":{"maxDuration":15,"includeFiles":"docs/superpowers/tech-packs/2026-09-29-rafii-control-v2/rafii-control-v2/{catalogs,contracts}/**","excludeFiles":"{control-web/**,web/**,**/__pycache__/**,**/*.pyc}"}}}
  },
  "rewrites":[
    {"source":"/api/control/v2/(.*)","destination":{"service":"control_api"}},
    {"source":"/(.*)","destination":{"service":"control_web"}}
  ],
  "headers":[{"source":"/(.*)","headers":[{"key":"Cache-Control","value":"private, no-store"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"},{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}]}]
}
