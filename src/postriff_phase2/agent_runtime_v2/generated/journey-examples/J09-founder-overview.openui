root = RafiiRoot([attention, revenue, costs, sources], "This month")
att = Query("founder_attention", {limit: 5}, null)
rev = Query("founder_metrics", {metricIds: ["mrr", "cash_collected"], period: "mtd"}, null)
cost = Query("founder_costs", {dimension: "feature", period: "mtd"}, null)
src = Query("founder_sources", {}, null)
attention = FounderAttentionList(att)
revenue = FounderMetricsTable(rev)
costs = FounderCostBreakdown(cost)
sources = FounderSourceHealth(src)
