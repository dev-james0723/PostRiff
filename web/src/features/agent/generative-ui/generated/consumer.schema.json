{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "RafiiRoot": {
      "$ref": "#/$defs/RafiiRoot"
    },
    "Stack": {
      "$ref": "#/$defs/Stack"
    },
    "Grid": {
      "$ref": "#/$defs/Grid"
    },
    "Section": {
      "$ref": "#/$defs/Section"
    },
    "Card": {
      "$ref": "#/$defs/Card"
    },
    "Tabs": {
      "$ref": "#/$defs/Tabs"
    },
    "TabItem": {
      "$ref": "#/$defs/TabItem"
    },
    "Accordion": {
      "$ref": "#/$defs/Accordion"
    },
    "AccordionItem": {
      "$ref": "#/$defs/AccordionItem"
    },
    "Text": {
      "$ref": "#/$defs/Text"
    },
    "EmptyState": {
      "$ref": "#/$defs/EmptyState"
    },
    "LoadingState": {
      "$ref": "#/$defs/LoadingState"
    },
    "ErrorState": {
      "$ref": "#/$defs/ErrorState"
    },
    "ToolBoundTable": {
      "$ref": "#/$defs/ToolBoundTable"
    },
    "ToolBoundChart": {
      "$ref": "#/$defs/ToolBoundChart"
    },
    "Metric": {
      "$ref": "#/$defs/Metric"
    },
    "Timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "Comparison": {
      "$ref": "#/$defs/Comparison"
    },
    "TaskStatus": {
      "$ref": "#/$defs/TaskStatus"
    },
    "EvidenceLink": {
      "$ref": "#/$defs/EvidenceLink"
    },
    "SelectionList": {
      "$ref": "#/$defs/SelectionList"
    },
    "AssetPreview": {
      "$ref": "#/$defs/AssetPreview"
    },
    "Form": {
      "$ref": "#/$defs/Form"
    },
    "TextField": {
      "$ref": "#/$defs/TextField"
    },
    "Select": {
      "$ref": "#/$defs/Select"
    },
    "DateRange": {
      "$ref": "#/$defs/DateRange"
    },
    "Button": {
      "$ref": "#/$defs/Button"
    },
    "ActionButton": {
      "$ref": "#/$defs/ActionButton"
    }
  },
  "required": [
    "RafiiRoot",
    "Stack",
    "Grid",
    "Section",
    "Card",
    "Tabs",
    "TabItem",
    "Accordion",
    "AccordionItem",
    "Text",
    "EmptyState",
    "LoadingState",
    "ErrorState",
    "ToolBoundTable",
    "ToolBoundChart",
    "Metric",
    "Timeline",
    "Comparison",
    "TaskStatus",
    "EvidenceLink",
    "SelectionList",
    "AssetPreview",
    "Form",
    "TextField",
    "Select",
    "DateRange",
    "Button",
    "ActionButton"
  ],
  "additionalProperties": false,
  "$defs": {
    "RafiiRoot": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "The one root of every view: root = RafiiRoot([...]). Children stack vertically. title is an optional short heading."
    },
    "Stack": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "direction": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "gap": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "Groups components in a column (default) or a wrapping row. gap: sm | md | lg."
    },
    "Grid": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "columns": {
          "type": "number"
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "Responsive grid of 1 to 4 columns that collapses to one column in narrow spaces such as the side panel."
    },
    "Section": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {}
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "description": "A titled region of the view. Use for each distinct part of a dense answer."
    },
    "Card": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "enum": [
            "default",
            "muted",
            "highlight"
          ]
        }
      },
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "description": "A bordered surface for one item or one idea. tone: default | muted | highlight."
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabItem"
          }
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "description": "Switches between TabItem panels locally. Bind value to a $variable to let other components react to the open tab."
    },
    "TabItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {}
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "children"
      ],
      "additionalProperties": false,
      "description": "One tab of Tabs. value is a stable id; it defaults to the label."
    },
    "Accordion": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccordionItem"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "description": "Collapsible sections for secondary detail such as methods, definitions or long lists."
    },
    "AccordionItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {}
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "children"
      ],
      "additionalProperties": false,
      "description": "One collapsible part of an Accordion."
    },
    "Text": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": [
            "body",
            "muted",
            "heading",
            "caption",
            "emphasis"
          ]
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false,
      "description": "Plain text you write (commentary, a heading or a caption). Never type figures, record titles, statuses or sources here: show those through bound data components."
    },
    "EmptyState": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "description": "Says that nothing matched or that no data exists yet. Use it when no binding fits the request: never invent data."
    },
    "LoadingState": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "A quiet placeholder while something is being prepared."
    },
    "ErrorState": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "description": "Explains that something could not be shown, in plain words, with what the person can do next."
    },
    "ToolBoundTable": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "percent",
                  "currency",
                  "duration",
                  "date",
                  "datetime",
                  "status",
                  "link"
                ]
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "cursor": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "rowsField": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "columns"
      ],
      "additionalProperties": false,
      "description": "A table of rows from a Query. columns pick fields of each row. Sorting is local. Bind cursor to the $variable used as the query cursor argument to page through results. Unknown values show as \"Not available\", never as zero. rowsField names the list inside the result when the data is not itself a list (for example \"drafts\")."
    },
    "ToolBoundChart": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "kind": {
          "type": "string",
          "enum": [
            "line",
            "bar"
          ]
        },
        "x": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "rowsField": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "kind",
        "x",
        "series"
      ],
      "additionalProperties": false,
      "description": "A line or bar chart of rows from a Query: x is the field for the horizontal axis, series are numeric fields. Missing values stay gaps, never zero. A data table alternative is always included. rowsField names the list inside the result when the data is not itself a list (for example \"drafts\")."
    },
    "Metric": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "number",
            "percent",
            "currency",
            "duration"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "field",
        "label"
      ],
      "additionalProperties": false,
      "description": "One server-computed figure from a field of a Query result (dots reach nested fields, for example \"totals.reach\"), with its unit, as-of time and coverage. Shows \"Not measured\" when the value is unknown."
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "timeField": {
          "type": "string"
        },
        "titleField": {
          "type": "string"
        },
        "statusField": {
          "type": "string"
        },
        "descriptionField": {
          "type": "string"
        },
        "rowsField": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "timeField",
        "titleField"
      ],
      "additionalProperties": false,
      "description": "Rows from a Query in time order, with dates in the person’s time zone. rowsField names the list inside the result when the data is not itself a list (for example \"drafts\")."
    },
    "Comparison": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "labelField": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "percent",
                  "currency",
                  "duration",
                  "date",
                  "datetime",
                  "status",
                  "link"
                ]
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "idField": {
          "type": "string"
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rowsField": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "labelField",
        "fields"
      ],
      "additionalProperties": false,
      "description": "Side-by-side comparison of rows from a Query (for example drafts or campaigns). Bind selected to a $variable holding row ids to compare only those. rowsField names the list inside the result when the data is not itself a list (for example \"drafts\")."
    },
    "TaskStatus": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "labelField": {
          "type": "string"
        },
        "statusField": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "description": "The real state of a task or record from a Query (for example preparing, needs review, saved, scheduled, published). The state shown is exactly what the data says."
    },
    "EvidenceLink": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false,
      "description": "A link to a source or record. href is an in-app path such as \"/app/library\", or a URL taken from bound data. Never invent a web address."
    },
    "SelectionList": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "labelField": {
          "type": "string"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idField": {
          "type": "string"
        },
        "descriptionField": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "rowsField": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "labelField"
      ],
      "additionalProperties": false,
      "description": "Lets the person pick rows from a Query. value is a $variable that receives the picked row ids in the order they were picked. max limits how many. rowsField names the list inside the result when the data is not itself a list (for example \"drafts\")."
    },
    "AssetPreview": {
      "type": "object",
      "properties": {
        "item": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "size": {
          "type": "string",
          "enum": [
            "row",
            "card",
            "detail"
          ]
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false,
      "description": "A safe preview of one Library item (image, video, audio, document or link) taken from bound data, for example inside @Each over a Query result. size: row | card | detail."
    },
    "Form": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "name",
        "children"
      ],
      "additionalProperties": false,
      "description": "Groups input fields under one name. Put an ActionButton inside to submit them through a registered action."
    },
    "TextField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "multiline": {
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "minLength": {
              "type": "number"
            },
            "maxLength": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "label"
      ],
      "additionalProperties": false,
      "description": "A labelled text input. Bind value to a $variable to use it in Query arguments or other components."
    },
    "Select": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "value": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "options"
      ],
      "additionalProperties": false,
      "description": "A labelled choice from options. Bind value to a $variable to filter a Query or switch what is shown."
    },
    "DateRange": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "label"
      ],
      "additionalProperties": false,
      "description": "Start and end dates (YYYY-MM-DD) in the person’s time zone, at most 366 days apart. Bind value to a $variable and pass it to a Query."
    },
    "Button": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "action": {},
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "quiet"
          ]
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "A local control that never changes saved data: Action([@Set($v, x)]), @Reset, @Run(query) to refresh, @ToAssistant(\"follow-up\") or @OpenUrl(\"/app/…\"). variant: primary | secondary | quiet."
    },
    "ActionButton": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string"
        },
        "formName": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "actionId"
      ],
      "additionalProperties": false,
      "description": "Starts one registered action by its id. Its label, confirmation and result come from Rafii, never from you. Inside a Form it sends that form’s fields; inputs adds bound values such as {draftIds: $picked}."
    }
  }
}
