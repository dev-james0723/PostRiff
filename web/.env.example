# Copy to .env.local for local development. Never commit .env.local.

# Public site origin. Used for metadataBase, Open Graph URLs and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth). Both are public values; database RLS is the real boundary.
# Leave unset to run the marketing site without auth; /app/* then redirects to sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin of the Python API for local development only. next.config.ts rewrites
# /api/* to this origin when it is set or when NODE_ENV=development.
# On Vercel the root vercel.json routes /api to the Python service; do not set it there.
POSTRIFF_API_ORIGIN=http://127.0.0.1:4331

# Sentry. Set NEXT_PUBLIC_SENTRY_DISABLED=1 to skip Sentry entirely (recommended locally).
NEXT_PUBLIC_SENTRY_DISABLED=1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
# Only needed to upload source maps in CI.
SENTRY_AUTH_TOKEN=
