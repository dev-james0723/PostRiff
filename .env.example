# Public Supabase project configuration, returned to the browser by /api/auth/config.
POSTRIFF_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
POSTRIFF_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only values. Use the Supabase transaction pooler on port 6543 with sslmode=require.
POSTRIFF_DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?sslmode=require
POSTRIFF_SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
CRON_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Billing (Stripe over HTTPS; no SDK). Leave unset to keep the labelled fixture provider: nothing is charged.
# STRIPE_SECRET_KEY: server-only restricted key (rk_live_/rk_test_; sk_ keys also accepted). Its prefix decides live vs test mode;
# every webhook must match it. STRIPE_WEBHOOK_SECRET: the endpoint signing secret for POST /api/billing/webhook.
STRIPE_SECRET_KEY=sk_live_OR_sk_test_FROM_STRIPE_DASHBOARD
STRIPE_WEBHOOK_SECRET=whsec_FROM_STRIPE_WEBHOOK_ENDPOINT
# Plan availability is a data decision, never code (decisions D3). Flip a proposal to a live offer in SQL:
#   update public.pr_plan_terms set status='active', provider_price_id='price_…' where id='studio-v1';
# Checkout refuses any plan whose status is not 'active'.

# Transactional email (Resend over HTTPS; no SDK). Leave unset to record notifications as not sent.
RESEND_API_KEY=re_FROM_RESEND_DASHBOARD
# Sender shown to customers; the domain must be verified in Resend.
EMAIL_FROM=PostRiff <hello@postriff.app>

# Paid model route (Vercel AI Gateway). Absent = deterministic preview only. Never commit real values.
AI_GATEWAY_API_KEY=
POSTRIFF_MODEL_ID=anthropic/claude-sonnet-5
# Optional: comma-separated selectable models; JSON prices {"model": [inputUsdPerMTok, outputUsdPerMTok]}.
# Every selectable model needs a price (here or in the built-in table): an unpriced one is listed as unavailable.
POSTRIFF_MODEL_IDS=
POSTRIFF_MODEL_PRICES=
# Optional: comma-separated models the picker shows first (default: openai/gpt-6-sol, anthropic/claude-sonnet-5,
# google/gemini-3.8-flash, bytedance/seed-2.1-turbo, minimax/minimax-m3). Ids not in POSTRIFF_MODEL_IDS are ignored.
POSTRIFF_FEATURED_MODEL_IDS=
# Execution providers each cloud model may run on, as AI Gateway provider slugs, e.g.
# {"anthropic/claude-sonnet-5":["anthropic"]}. Sent as providerOptions.gateway.only (no fallback outside
# the list). A model not listed runs only on its maker's own provider. The image model
# (POSTRIFF_IMAGE_MODEL) uses the same map; an image made elsewhere is not kept.
POSTRIFF_MODEL_PROVIDERS=

# Credits (opt-in, both off unless exactly "1"). Credits also need active plan terms carrying the credit
# policy; purchases additionally need Stripe. Turning them off stops new paid tasks; settlement,
# refunds and reconciliation of earlier usage keep working.
POSTRIFF_CREDITS_ENABLED=0
POSTRIFF_CREDIT_PURCHASES_ENABLED=0

# Image generation in agent chat uses this one managed route regardless of which writing model or
# local CLI is selected. It consumes a media credit and still obeys the approved spend budget.
POSTRIFF_IMAGE_MODEL=openai/gpt-image-2.5-flare
POSTRIFF_IMAGE_ESTIMATE_USD_MICRO=100000

# Web research before drafting (agent chat Phase 5). On a person's own machine it is on; on a
# hosted deployment (VERCEL=1 or POSTRIFF_HOSTED=1) each workspace must opt in under Memory →
# Web research, because the topic goes to Exa and page addresses go to the jina reader.
# POSTRIFF_RESEARCH=0 switches it off everywhere.
POSTRIFF_RESEARCH=1
# POSTRIFF_EXA_MCP_URL=https://mcp.exa.ai/mcp
# POSTRIFF_READER_URL=https://r.jina.ai/

# Rafii Agent Runtime (docs/design/site-agent/agent-runtime/ARCHITECTURE_LOCK.md). Off unless set; with it off the site
# agent answers exactly as before. OPENAI_API_KEY is server-only (Voice Mode needs it: GPT-Live sessions are created by the
# server); without it the runtime can use the AI Gateway key above, and Voice Mode reports that it is unavailable.
OPENAI_API_KEY=
RAFII_AGENT_V2_ENABLED=
RAFII_SPECIALISTS_ENABLED=
RAFII_VOICE_ENABLED=
RAFII_IMAGE_AGENT_ENABLED=
RAFII_PROACTIVE_V2_ENABLED=
# openai | gateway (default: openai when OPENAI_API_KEY is set, else gateway)
RAFII_AGENT_PROVIDER=
# Model aliases (defaults shown); pin dated snapshots in production after the evals pass.
RAFII_AGENT_PRIMARY_MODEL=gpt-6-sol
RAFII_AGENT_FAST_MODEL=gpt-6-luna
RAFII_AGENT_VISION_MODEL=gpt-6-sol
RAFII_AGENT_IMAGE_MODEL_QUALITY=gpt-image-2.5-sunburst
RAFII_AGENT_IMAGE_MODEL_FAST=gpt-image-2.5-flare
RAFII_LIVE_MODEL=gpt-live-1
# Optional JSON {"model": [inputUsdPerMTok, outputUsdPerMTok]}; a model without a price is never called.
RAFII_AGENT_MODEL_PRICES=
# USD per generated image, when the provider reports no cost: {"image_fast": 0.04, "image_quality": 0.19}
RAFII_AGENT_IMAGE_PRICES=
# Export Agents SDK traces to OpenAI (never under Zero Data Retention). Off by default.
RAFII_AGENT_OPENAI_TRACING=

# Rafii Adaptive Social Coworker (docs/design/site-agent/adaptive-social-coworker/ROLLOUT.md).
# Off unless set to 1/true/yes/on; with every flag off the coworker features do nothing (ROLLOUT.md lists what ships
# regardless of flags). Preview deployments refuse the egress flags (notifications, web push, research broker, listening).
RAFII_SKILL_REGISTRY_V2_ENABLED=
RAFII_NOTIFICATIONS_V2_ENABLED=
RAFII_WEB_PUSH_ENABLED=
RAFII_ADAPTIVE_SKILLS_ENABLED=
RAFII_WEEKLY_OPERATOR_ENABLED=
RAFII_RESEARCH_BROKER_ENABLED=
RAFII_CREATIVE_AGENT_ENABLED=
RAFII_PERFORMANCE_LEARNING_ENABLED=
RAFII_LISTENING_ENABLED=
RAFII_ENGAGEMENT_COPILOT_ENABLED=
RAFII_GROWTH_EXPERIMENTS_ENABLED=
# Resend webhook signing secret (Svix, "whsec_..."): delivery, bounce and complaint events.
RESEND_WEBHOOK_SECRET=
# Web Push VAPID keys (base64url P-256; generate with notifications.push.generate_vapid_keys) and a contact.
POSTRIFF_VAPID_PUBLIC_KEY=
POSTRIFF_VAPID_PRIVATE_KEY=
POSTRIFF_VAPID_SUBJECT=mailto:ops@example.com
# Signs one-click unsubscribe links (falls back to a key derived from POSTRIFF_CREDENTIAL_KEY).
POSTRIFF_NOTIFICATION_SIGNING_KEY=
# Local harness only: lets the Research Broker use Agent Reach on this machine. Never set on a hosted deployment.
POSTRIFF_AGENT_REACH=
